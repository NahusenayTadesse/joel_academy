DATABASE_URL=mysql://academy:password@127.0.0.1:3306/joel_academy
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ORIGIN=http://localhost:5173
# Payment receipts and course images can be up to 10 MB.
BODY_SIZE_LIMIT=11M
# Optional: Bunny Stream "Token authentication" key, to sign lesson video links so copies expire.
BUNNY_STREAM_TOKEN_KEY=
# Email (SMTP). Without SMTP_HOST, emails are not sent but kept in the dashboard's email log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Joel Talargie Academy <no-reply@example.com>"
# Optional: comma-separated addresses for staff notifications (defaults to every administrator).
ADMIN_NOTIFY_EMAIL=
# Chapa online payments (test keys start CHASECK_TEST-). The webhook secret is set in Chapa's dashboard.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# Google sign-in (OAuth client "Web application"; redirect URI <ORIGIN>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMS (GeezSMS). Without SMS_KEY, texts are not sent but kept in the dashboard's SMS log.
SMS_KEY=
# Optional: a GeezSMS sender (shortcode) id registered for the academy; otherwise the account default.
SMS_SHORTCODE_ID=
# Optional: comma-separated phone numbers for staff SMS alerts (new receipts, contact messages).
ADMIN_NOTIFY_PHONE=
